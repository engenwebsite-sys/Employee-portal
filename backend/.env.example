# Copy this file to ".env" and change the values.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nemilink_portal
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Step 2: authentication ---
# Generate a real secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-change-me-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Microsoft Entra ID SSO ---
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5173/auth/microsoft/callback
ALLOWED_LOGIN_DOMAINS=nemilink.com,maargaai.com,engencbss.com
SUPER_ADMIN_EMAILS=sivachandran@maargaai.com
