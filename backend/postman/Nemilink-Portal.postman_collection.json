{
  "info": {
    "name": "Nemilink Employee Portal API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/health"
          }
        },
        {
          "name": "Database health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('db connected', () => pm.expect(pm.response.json().database).to.eql('connected'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/health/db"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Login: HR (first login, must change password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hr@nemilink.com\",\n  \"password\": \"Welcome@123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', j.access_token);",
                  "pm.collectionVariables.set('refreshToken', j.refresh_token);",
                  "pm.test('role set', () => pm.expect(j.user.role).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Login: Manager",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@nemilink.com\",\n  \"password\": \"Welcome@123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', j.access_token);",
                  "pm.collectionVariables.set('refreshToken', j.refresh_token);",
                  "pm.test('role set', () => pm.expect(j.user.role).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Login: Employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employee@nemilink.com\",\n  \"password\": \"Welcome@123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', j.access_token);",
                  "pm.collectionVariables.set('refreshToken', j.refresh_token);",
                  "pm.test('role set', () => pm.expect(j.user.role).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Refresh token (old one stops working)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', j.access_token);",
                  "pm.collectionVariables.set('refreshToken', j.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Change password (use after logging in as HR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/change-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"Welcome@123\",\n  \"new_password\": \"HrNewPass123\"\n}"
            },
            "description": "After this HR's password is HrNewPass123. Reset with: python -m app.scripts.seed_users --demo --reset"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', j.access_token);",
                  "pm.collectionVariables.set('refreshToken', j.refresh_token);",
                  "pm.test('flag cleared', () => pm.expect(j.user.must_change_password).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Me",
      "item": [
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Role guard checks (dev only)",
      "description": "Log in as each role first (Auth 1-3), then run these. Expected: Employee 200/403/403, Manager 200/200/403, HR 200/200/200. HR gets 403 password_change_required until the password is changed.",
      "item": [
        {
          "name": "Any role",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/dev/any-role"
          }
        },
        {
          "name": "Manager or HR",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/dev/manager-or-hr"
          }
        },
        {
          "name": "HR only",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/dev/hr-only"
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  }
}